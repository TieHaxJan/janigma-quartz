# Produktions-Image: Quartz bauen, danach statisch per nginx ausliefern.
# (Die Datei "Dockerfile" bleibt die Upstream-Vorschau mit `quartz build --serve`.)

FROM node:22-slim AS builder
WORKDIR /usr/src/app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx quartz build

FROM nginx:1-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/src/app/public /usr/share/nginx/html
EXPOSE 80
